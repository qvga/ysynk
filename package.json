{
  "name": "ysynk-desktop",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:dependencies": "node tools/check-frontend-dependencies.cjs && node --test vendor/deepmerge/test-ysynk.cjs",
    "build": "vite build",
    "desktop": "cd desktop && tauri dev",
    "desktop:build": "cd desktop && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "deepmerge": "file:vendor/deepmerge",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "deepmerge": "$deepmerge"
  }
}
